{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "grammai",
  "version": "0.6.6",
  "description": "Free grammar checking. Bring your own Claude Code or Codex for AI rewrites, translation and context checks.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "nativeMessaging",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "grammai settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "open-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open or close grammai for the focused text field"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Translate selected text with grammai"
    },
    "rewrite-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Rewrite selected text with grammai"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' *"
  },
  "web_accessible_resources": [
    {
      "resources": ["brand/icon.png"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ]
}
