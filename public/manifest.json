{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "grammai",
  "version": "0.6.6",
  "description": "Free grammar checking. Bring your own Claude Code or Codex for AI rewrites, translation and context checks.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "nativeMessaging",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "grammai settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["brand/icon.png"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ]
}
